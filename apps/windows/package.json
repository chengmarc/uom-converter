{
  "name": "@uom/windows",
  "productName": "UOM Converter",
  "description": "Unit-of-measure conversions for the electrical industry.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --config electron-builder.config.cjs --win",
    "dist:store": "vite build && electron-builder --config electron-builder.config.cjs --win appx",
    "store:assets": "vite build && electron scripts/render.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@uom/brand": "*",
    "@uom/converters": "*",
    "@uom/core": "*",
    "@uom/ui": "*",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
