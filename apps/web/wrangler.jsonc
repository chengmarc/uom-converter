// The website on Cloudflare Workers: static files only (apps/web/dist/, from `npm run web:build`),
// no Worker code. `npm run web:deploy` builds and deploys it; so does Cloudflare's Git integration
// (Workers Builds) on every push to main. Response headers are in dist/_headers, written by scripts/cloudflare.ts.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uom-converter",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown addresses get 404.html with a 404 status. HTML handling is left at the default
    // (auto-trailing-slash): units/feet-to-metres.html is served at /units/feet-to-metres, and the
    // .html and trailing-slash spellings redirect there. dist/_redirects makes the .html redirects
    // permanent (301), and sends the addresses of pages that have moved to where they are now.
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "uom-converter.com", "custom_domain": true }],
  // No *.workers.dev copy of the site competing with the domain in search results.
  "workers_dev": false,
  "preview_urls": false
}
