{
  "name": "uom-converter",
  "description": "Unit-of-measure conversions for the electrical industry.",
  "private": true,
  "version": "1.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "web:dev": "npm run dev -w @uom/web",
    "web:build": "npm run build -w @uom/web",
    "web:check": "npm run check -w @uom/web",
    "web:preview": "npm run preview -w @uom/web",
    "web:deploy": "npm run deploy -w @uom/web",
    "windows:dev": "npm run dev -w @uom/windows",
    "windows:start": "npm run start -w @uom/windows",
    "windows:dist": "npm run dist -w @uom/windows",
    "windows:appx": "npm run appx -w @uom/windows",
    "windows:assets": "npm run assets -w @uom/windows",
    "android:dev": "npm run dev -w @uom/android",
    "android:emulator": "npm run emulator -w @uom/android",
    "android:icons": "npm run icons -w @uom/android",
    "android:sync": "npm run sync -w @uom/android",
    "android:run": "npm run run -w @uom/android",
    "android:apk": "npm run apk -w @uom/android",
    "android:aab": "npm run aab -w @uom/android"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
