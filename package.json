{
  "name": "uom-converter",
  "productName": "UOM Converter",
  "description": "Unit-of-measure conversions for the electrical industry.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "platforms/windows/electron/main.cjs",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "dev": "vite --config platforms/web/vite.config.ts",
    "build:web": "vite build --config platforms/web/vite.config.ts",
    "preview:web": "vite preview --config platforms/web/vite.config.ts",
    "app": "vite build --config platforms/windows/vite.config.ts && electron .",
    "dist:win": "vite build --config platforms/windows/vite.config.ts && electron-builder --config platforms/windows/electron-builder.json --win",
    "dist:store": "vite build --config platforms/windows/vite.config.ts && electron-builder --config platforms/windows/electron-builder.json --win appx",
    "store:assets": "vite build --config platforms/windows/vite.config.ts && electron platforms/windows/store/render.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
