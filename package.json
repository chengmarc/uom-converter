{
  "name": "uom-converter",
  "productName": "UOM Converter",
  "description": "Unit-of-measure conversions for the electrical industry.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/electron/main.cjs",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "app": "vite build src/web --outDir ../../dist --emptyOutDir --base ./ && electron .",
    "dist:win": "vite build src/web --outDir ../../dist --emptyOutDir --base ./ && electron-builder --win",
    "dist:store": "vite build src/web --outDir ../../dist --emptyOutDir --base ./ && electron-builder --win appx",
    "store:assets": "vite build src/web --outDir ../../dist --emptyOutDir --base ./ && electron store/render.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.uomconverter.app",
    "files": [
      "dist/**",
      "src/electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "store"
    },
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "UOM-Converter-setup.exe"
    },
    "portable": {
      "artifactName": "UOM-Converter-portable.exe"
    },
    "appx": {
      "identityName": "00000Publisher.UOMConverter",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "Publisher Name",
      "applicationId": "UOMConverter",
      "displayName": "UOM Converter",
      "backgroundColor": "transparent",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "languages": [
        "en-US"
      ],
      "artifactName": "UOM-Converter-${version}.${ext}"
    }
  }
}
