{
  "name": "uom-converter",
  "description": "Unit-of-measure conversions for the electrical industry.",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "dev": "npm run dev -w @uom/web",
    "dev:windows": "npm run dev -w @uom/windows",
    "dev:android": "npm run dev -w @uom/android",
    "build:web": "npm run build -w @uom/web",
    "preview:web": "npm run preview -w @uom/web",
    "deploy:web": "npm run deploy -w @uom/web",
    "app": "npm run start -w @uom/windows",
    "dist:win": "npm run dist -w @uom/windows",
    "dist:store": "npm run dist:store -w @uom/windows",
    "store:assets": "npm run store:assets -w @uom/windows",
    "android:icons": "npm run icons -w @uom/android",
    "android:sync": "npm run sync -w @uom/android",
    "android:run": "npm run run -w @uom/android",
    "android:apk": "npm run apk -w @uom/android",
    "android:aab": "npm run aab -w @uom/android"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
